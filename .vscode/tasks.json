{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Build Crypto C++11",
			"command": "g++",
			"args": [
				"-std=c++11",
				"*.cpp",
				"-o",
				"crypto",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: /usr/bin/clang++"
		}
	]
}